{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rhino-miro-auth",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	// Deploys to https://rhino-miro-auth.<your-subdomain>.workers.dev.
	// To serve it on your own domain instead, add for example:
	//   "routes": [{ "pattern": "rhino-miro.example.com", "custom_domain": true }]
	// and set PUBLIC_BASE_URL to match. Keep personal settings in an untracked
	// wrangler.local.jsonc and deploy it with `npm run deploy:local`.
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		// Public URL of this Worker. Empty = use the URL each request arrives on.
		// The Miro app's redirect URI must be <PUBLIC_BASE_URL>/callback.
		"PUBLIC_BASE_URL": "",
		// Client ID from the Miro developer dashboard (not secret).
		"MIRO_CLIENT_ID": ""
	}
	// Secrets (set with `npx wrangler secret put <NAME>`, never in this file):
	//   MIRO_CLIENT_SECRET  from the Miro developer dashboard.
	//   TOKEN_KEY           32+ random bytes, base64. Seals the login flow and token tickets.
	//                       e.g. `openssl rand -base64 32 | npx wrangler secret put TOKEN_KEY`
}
